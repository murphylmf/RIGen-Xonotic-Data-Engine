#pragma once

CLASS(WalkerTurretAttack, PortoLaunch)
                ATTRIB(WalkerTurretAttack, spawnflags, int, WEP_FLAG_HIDDEN | WEP_FLAG_SPECIALATTACK);
                ATTRIB(WalkerTurretAttack, impulse, int, 5);
                ATTRIB(WalkerTurretAttack, netname, string, "turret_walker");
                ATTRIB(WalkerTurretAttack, m_name, string, _("Walker"));
ENDCLASS(WalkerTurretAttack)
REGISTER_WEAPON(WALKER, NEW(WalkerTurretAttack));
