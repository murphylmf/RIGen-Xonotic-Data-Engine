    W_PROPS(X, Hagar, hagar)
#undef X

ENDCLASS(Hagar)
REGISTER_WEAPON(HAGAR, hagar, NEW(Hagar));

SPAWNFUNC_WEAPON(weapon_hagar, WEP_HAGAR)
