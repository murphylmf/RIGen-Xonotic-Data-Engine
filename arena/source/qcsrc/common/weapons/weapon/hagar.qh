                ATTRIB(Hagar, impulse, int, 8);
                ATTRIB(Hagar, spawnflags, int, WEP_FLAG_NORMAL | WEP_FLAG_RELOADABLE | WEP_FLAG_CANCLIMB | WEP_TYPE_SPLASH);
                ATTRIB(Hagar, bot_pickupbasevalue, float, 6000);
                ATTRIB(Hagar, wpcolor, vector, '1 1 0.5');
                ATTRIB(Hagar, mdl, string, "hagar");
#ifdef GAMEQC
                ATTRIB(Hagar, m_model, Model, MDL_HAGAR_ITEM);
                ATTRIB(Hagar, m_muzzlemodel, Model, MDL_Null);
                ATTRIB(Hagar, m_muzzleeffect, entity, EFFECT_HAGAR_MUZZLEFLASH);
#endif
                ATTRIB(Hagar, w_crosshair, string, "gfx/crosshairhagar");
                ATTRIB(Hagar, w_crosshair_size, float, 0.8);
                ATTRIB(Hagar, model2, string, "weaponhagar");
                ATTRIB(Hagar, netname, string, "hagar");
                ATTRIB(Hagar, m_name, string, _("Hagar"));

