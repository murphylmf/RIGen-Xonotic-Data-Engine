#pragma once

#include "spiderbot_weapons.qh"

CLASS(Spiderbot, Vehicle)
                 ATTRIB(Spiderbot, spawnflags, int, VHF_DMGSHAKE);
                 ATTRIB(Spiderbot, m_mins, vector, '-75 -75 10');
                 ATTRIB(Spiderbot, m_maxs, vector, '75 75 125');
                 ATTRIB(Spiderbot, view_ofs, vector, '0 0 70');
                 ATTRIB(Spiderbot, height, float, 170);
#ifdef GAMEQC
              ATTRIB(Spiderbot, mdl, string, "models/vehicles/spiderbot.dpm");
              ATTRIB(Spiderbot, model, string, "models/vehicles/spiderbot.dpm");
                 ATTRIB(Spiderbot, head_model, string, "models/vehicles/spiderbot_top.dpm");
                 ATTRIB(Spiderbot, hud_model, string, "models/vehicles/spiderbot_cockpit.dpm");
                 ATTRIB(Spiderbot, tag_head, string, "tag_head");
                 ATTRIB(Spiderbot, tag_hud, string, "tag_hud");
                 ATTRIB(Spiderbot, tag_view, string, "");
#endif
                 ATTRIB(Spiderbot, netname, string, "spiderbot");
                 ATTRIB(Spiderbot, vehicle_name, string, _("Spiderbot"));
                 ATTRIB(Spiderbot, m_icon, string, "vehicle_spider");
ENDCLASS(Spiderbot)

REGISTER_VEHICLE(SPIDERBOT, NEW(Spiderbot));
