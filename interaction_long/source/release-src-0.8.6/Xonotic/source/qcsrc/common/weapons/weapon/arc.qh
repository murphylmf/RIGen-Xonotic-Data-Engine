#pragma once

CLASS(Arc, Weapon)
                ATTRIB(Arc, m_canonical_spawnfunc, string, "weapon_arc");
                ATTRIB(Arc, ammo_type, Resource, RES_CELLS);
                ATTRIB(Arc, impulse, int, 3);
                ATTRIB(Arc, spawnflags, int, WEP_TYPE_HITSCAN);
                ATTRIB(Arc, bot_pickupbasevalue, float, 8000);
                ATTRIB(Arc, wpcolor, vector, '1 1 1');
                ATTRIB(Arc, mdl, string, "arc");
#ifdef GAMEQC
                ATTRIB(Arc, m_model, Model, MDL_ARC_ITEM);
                ATTRIB(Arc, m_muzzlemodel, Model, MDL_Null);
                ATTRIB(Arc, m_muzzleeffect, entity, EFFECT_ARC_MUZZLEFLASH);
#endif
                ATTRIB(Arc, w_crosshair, string, "gfx/crosshairhlac");
                ATTRIB(Arc, w_crosshair_size, float, 0.7);
                ATTRIB(Arc, model2, string, "weaponarc");
                ATTRIB(Arc, netname, string, "arc");
                ATTRIB(Arc, m_name, string, _("Arc"));

