#pragma once

CLASS(FlacAttack, PortoLaunch)
                ATTRIB(FlacAttack, spawnflags, int, WEP_FLAG_SPECIALATTACK | WEP_FLAG_HIDDEN);
                ATTRIB(FlacAttack, impulse, int, 5);
                ATTRIB(FlacAttack, netname, string, "turret_flac");
                ATTRIB(FlacAttack, m_name, string, _("FLAC"));
ENDCLASS(FlacAttack)
REGISTER_WEAPON(FLAC, NEW(FlacAttack));
