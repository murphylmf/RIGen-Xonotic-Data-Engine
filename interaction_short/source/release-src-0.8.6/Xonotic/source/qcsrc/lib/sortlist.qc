#include "sortlist.qh"

ERASEABLE
entity Sort_Spawn()
{
	entity sort = new_pure(sortlist);
	sort.sort_next = NULL;
	sort.chain = sort;
	return sort;
}
  
                                         
 
                
                   
                        
                          
                      
                
 

                             
 
                
                         
     
                              
                     
                    
     
                 
 

                                      
 
                        
                  
                          
               
     
                                     
                  
                      
                              
     
                         
                           
                           
            
                             
 

                            
 
                      
 

                               
 
                                          
 

                             
 
                
                                
               
                       
                                    
                                    
                              
     
                      
                
 

                             
 
                
                      
             
               

                         
     
                              
                                        
                     
     
 

                                     
 
                                        
                              
                
 
  

  
                           
 
                                            
                     
                                                
                
 

                                
 
               
                                                       
     
                            
         
                                
                                      
         
     
 
  
