#pragma once

entityclass(Sort);
                                  
classfield(Sort).entity chain, sort_next, sort_prev;

entity Sort_Spawn();

   
                                     
                        
                          
   
#define SORT_SWAP(a, b)                                  \
	b.sort_prev = a.sort_prev;                          \
	a.sort_next = b.sort_next;                          \
	if (b.sort_next) b.sort_next.sort_prev = a;          \
	if (a.sort_prev) a.sort_prev.sort_next = b;          \
	a.sort_prev = b;                                    \
	b.sort_next = a
