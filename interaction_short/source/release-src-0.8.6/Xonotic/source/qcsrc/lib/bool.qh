#pragma once

#ifndef QCC_SUPPORT_BOOL
	                    
	const int true  = 1;
	const int false = 0;
#endif

#define boolean(value) ((value) != 0)

                                                                  
ERASEABLE
float InterpretBoolean(string input)
{
	switch (strtolower(input))
	{
		case "yes":
		case "true":
		case "on":
			return true;

		case "no":
		case "false":
		case "off":
			return false;

		default: return boolean(stof(input));
	}
}
