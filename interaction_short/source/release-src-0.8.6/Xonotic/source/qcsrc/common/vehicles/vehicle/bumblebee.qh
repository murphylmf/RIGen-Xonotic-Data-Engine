#pragma once

#include "bumblebee_weapons.qh"

CLASS(Bumblebee, Vehicle)
                 ATTRIB(Bumblebee, spawnflags, int, VHF_DMGSHAKE);
                 ATTRIB(Bumblebee, m_mins, vector, '-245 -130 -130');
                 ATTRIB(Bumblebee, m_maxs, vector, '230 130 130');
                 ATTRIB(Bumblebee, view_ofs, vector, '0 0 300');
                 ATTRIB(Bumblebee, height, float, 450);
#ifdef GAMEQC
              ATTRIB(Bumblebee, mdl, string, "models/vehicles/bumblebee_body.dpm");
              ATTRIB(Bumblebee, model, string, "models/vehicles/bumblebee_body.dpm");
                 ATTRIB(Bumblebee, head_model, string, "");
                 ATTRIB(Bumblebee, hud_model, string, "models/vehicles/spiderbot_cockpit.dpm");
                 ATTRIB(Bumblebee, tag_head, string, "");
                 ATTRIB(Bumblebee, tag_hud, string, "");
                 ATTRIB(Bumblebee, tag_view, string, "tag_viewport");
#endif
                 ATTRIB(Bumblebee, netname, string, "bumblebee");
                 ATTRIB(Bumblebee, vehicle_name, string, _("Bumblebee"));
                 ATTRIB(Bumblebee, m_icon, string, "vehicle_bumble");
ENDCLASS(Bumblebee)
REGISTER_VEHICLE(BUMBLEBEE, NEW(Bumblebee));

#ifdef GAMEQC
	MODEL(VEH_BUMBLEBEE_GUNCOCKPIT, "models/vehicles/wakizashi_cockpit.dpm");
#endif

