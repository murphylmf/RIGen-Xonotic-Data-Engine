#pragma once

#include "dialog.qh"
CLASS(Tab, Dialog)
	ATTRIB(Tab, isTabRoot, float, 0);
	ATTRIB(Tab, closable, float, 0);
	ATTRIB(Tab, rootDialog, float, 0);
	ATTRIB(Tab, title, string);
	ATTRIB(Tab, titleFontSize, float, 0);           

	                         
	ATTRIB(Tab, intendedWidth, float, 0);
	ATTRIB(Tab, rows, float, 3);
	ATTRIB(Tab, columns, float, 2);

	ATTRIB(Tab, marginTop, float, 0);              
	ATTRIB(Tab, marginBottom, float, 0);           
	ATTRIB(Tab, marginLeft, float, 0);             
	ATTRIB(Tab, marginRight, float, 0);            
	ATTRIB(Tab, columnSpacing, float, 0);          
	ATTRIB(Tab, rowSpacing, float, 0);             
	ATTRIB(Tab, rowHeight, float, 0);              
	ATTRIB(Tab, titleHeight, float, 0);            

	ATTRIB(Tab, backgroundImage, string);
ENDCLASS(Tab)
