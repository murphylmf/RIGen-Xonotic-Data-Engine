@@ -0,0 +1,35 @@
+#pragma once
+
+bool autocvar_capture_server_enable;
+string autocvar_capture_episode_id;
+string autocvar_capture_server_log;
+vector autocvar_capture_player_origin;
+vector autocvar_capture_enemy_origin;
+vector autocvar_capture_enemy_motion_vector;
+float autocvar_capture_player_yaw;
+float autocvar_capture_enemy_yaw;
+int autocvar_capture_enemy_motion;
+float autocvar_capture_enemy_motion_distance;
+string autocvar_capture_enemy_model;
