From 7c6429a8950a88b8bc68330ca2e8cca31a43a7f3 Mon Sep 17 00:00:00 2001
From: RIGen local capture
Date: Sat, 25 Jul 2026 01:15:18 +0800
Subject: [PATCH 34/36] Bind capture seed to authoritative action schedule

---
 source/qcsrc/server/capture.qc | 43 +++++++++++++---------------------
 source/qcsrc/server/capture.qh |  1 -
 2 files changed, 16 insertions(+), 28 deletions(-)

diff --git a/source/qcsrc/server/capture.qc b/source/qcsrc/server/capture.qc
index 07412a3..4120433 100644
--- a/source/qcsrc/server/capture.qc
+++ b/source/qcsrc/server/capture.qc
@@ -108,10 +108,21 @@ bool Capture_LoadAuthoritativeActions()
 		return false;
 	}
 	capture_action_count = 0;
+	capture_episode_seed = 0;
+	capture_weapon_random_seed = 0;
 	float yaw = autocvar_capture_player_yaw;
 	float pitch = 0;
 	for(string line; (line = fgets(fh)); )
 	{
+		if(substring(line, 0, 6) == "#seed,")
+		{
+			if(tokenizebyseparator(line, ",") == 2)
+			{
+				capture_episode_seed = stof(argv(1));
+				capture_weapon_random_seed = crc16(false, argv(1));
+			}
+			continue;
+		}
 		if(line == "" || substring(line, 0, 5) == "tick,")
 			continue;
 		int fields = tokenizebyseparator(line, ",");
@@ -144,10 +155,12 @@ bool Capture_LoadAuthoritativeActions()
 		++capture_action_count;
 	}
 	fclose(fh);
-	if(capture_action_count != CAPTURE_ACTION_COUNT)
+	if(capture_action_count != CAPTURE_ACTION_COUNT
+		|| capture_episode_seed <= 0)
 	{
-		LOG_WARNF("capture: expected %d authoritative actions, loaded %d",
-			CAPTURE_ACTION_COUNT, capture_action_count);
+		LOG_WARNF("capture: expected %d authoritative actions and positive seed,"
+			" loaded actions=%d seed=%.0f",
+			CAPTURE_ACTION_COUNT, capture_action_count, capture_episode_seed);
 		capture_action_count = 0;
 		return false;
 	}
@@ -156,28 +169,6 @@ bool Capture_LoadAuthoritativeActions()
 	return true;
 }
 
-bool Capture_LoadEpisodeSeed()
-{
-	int fh = fopen(autocvar_capture_server_seed_file, FILE_READ);
-	if(fh < 0)
-	{
-		LOG_WARN("capture: could not read episode seed file ",
-			autocvar_capture_server_seed_file);
-		return false;
-	}
-	string line = fgets(fh);
-	capture_episode_seed = stof(line);
-	capture_weapon_random_seed = crc16(false, line);
-	fclose(fh);
-	if(capture_episode_seed <= 0)
-	{
-		LOG_WARN("capture: episode seed file is empty or invalid ",
-			autocvar_capture_server_seed_file);
-		return false;
-	}
-	return true;
-}
-
 void Capture_ApplyAuthoritativeAction(entity actor)
 {
 	if(!autocvar_capture_server_enable || actor != capture_player)
@@ -280,8 +271,6 @@ bool Capture_TryReset()
 
 	if(!Capture_LoadAuthoritativeActions())
 		return false;
-	if(!Capture_LoadEpisodeSeed())
-		return false;
 	if(capture_server_fh >= 0)
 		fclose(capture_server_fh);
 	capture_server_fh = fopen(autocvar_capture_server_log, FILE_WRITE);
diff --git a/source/qcsrc/server/capture.qh b/source/qcsrc/server/capture.qh
index 5054bfa..71a6178 100644
--- a/source/qcsrc/server/capture.qh
+++ b/source/qcsrc/server/capture.qh
@@ -5,7 +5,6 @@ string autocvar_capture_episode_id;
 string autocvar_capture_anchor_id;
 string autocvar_capture_server_log;
 string autocvar_capture_server_action_file;
-string autocvar_capture_server_seed_file;
 vector autocvar_capture_player_origin;
 vector autocvar_capture_enemy_origin;
 vector autocvar_capture_enemy_motion_vector;
