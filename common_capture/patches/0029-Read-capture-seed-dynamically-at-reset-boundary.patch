From 214bf14fa537aa169bd54a155de07c085b890ff7 Mon Sep 17 00:00:00 2001
From: RIGen local capture
Date: Sat, 25 Jul 2026 01:03:57 +0800
Subject: [PATCH 29/36] Read capture seed dynamically at reset boundary

---
 source/qcsrc/server/capture.qc | 5 +++--
 source/qcsrc/server/capture.qh | 1 -
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/source/qcsrc/server/capture.qc b/source/qcsrc/server/capture.qc
index 333acba..edfc2cd 100644
--- a/source/qcsrc/server/capture.qc
+++ b/source/qcsrc/server/capture.qc
@@ -207,6 +207,7 @@ void Capture_ConfigurePlayerWeapon(entity actor)
 
 bool Capture_TryReset()
 {
+	string capture_episode_seed_text = cvar_string("capture_seed_text");
 	capture_player = NULL;
 	capture_enemy = NULL;
 	FOREACH_CLIENT(IS_REAL_CLIENT(it) && IS_PLAYER(it),
@@ -248,7 +249,7 @@ bool Capture_TryReset()
 	// consumes a timing-dependent number of global random values before the
 	// atomic episode reset, so capture weapon spread uses this private stream
 	// seeded exactly at the reset boundary.
-	capture_weapon_random_seed = crc16(false, autocvar_capture_seed_text);
+	capture_weapon_random_seed = crc16(false, capture_episode_seed_text);
 	Capture_ConfigurePlayerWeapon(capture_player);
 	setplayermodel(capture_enemy,
 		strcat("models/player/", autocvar_capture_enemy_model, ".iqm"));
@@ -309,7 +310,7 @@ bool Capture_TryReset()
 		autocvar_capture_episode_id, time, GetMapname(),
 		etof(capture_player), etof(capture_enemy),
 		autocvar_capture_weapon, autocvar_capture_enemy_model,
-		autocvar_capture_seed_text, capture_weapon_random_seed);
+		capture_episode_seed_text, capture_weapon_random_seed);
 	reset_row = strcat(reset_row, sprintf(
 		"\"anchor\":{\"id\":\"%s\",\"player_clear\":%d,\"enemy_clear\":%d,"
 		"\"player_ground\":%d,\"enemy_ground\":%d,"
diff --git a/source/qcsrc/server/capture.qh b/source/qcsrc/server/capture.qh
index 93128b0..71a6178 100644
--- a/source/qcsrc/server/capture.qh
+++ b/source/qcsrc/server/capture.qh
@@ -3,7 +3,6 @@
 bool autocvar_capture_server_enable;
 string autocvar_capture_episode_id;
 string autocvar_capture_anchor_id;
-string autocvar_capture_seed_text;
 string autocvar_capture_server_log;
 string autocvar_capture_server_action_file;
 vector autocvar_capture_player_origin;
